GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama3-8b-8192

# Embeddings
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Environment (local or production)
ENVIRONMENT=local

# Vector DB - Local Development
CHROMA_PATH=./chroma_db

# Vector DB - Production
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxx
PINECONE_USER_INDEX=user-documents

# RAG Config
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5
SCORE_THRESHOLD=0.5

# Memory
MAX_HISTORY=10

# LangSmith Monitoring
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxx
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=enterprise-legal-counsel-ai

# Security
MAX_REQUESTS_PER_MINUTE=10
MAX_QUESTION_LENGTH=500
MAX_PDF_SIZE_MB=20